{
  "name": "sma-lead-backend",
  "version": "1.0.1",
  "description": "Lead capture, PDF guide delivery, and email nurture backend for the San Miguel de Allende real estate site",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "init-db": "node scripts/init-db.js",
    "send-nurture": "node scripts/send-nurture.js",
    "ping-nurture": "node scripts/ping-nurture.js",
    "dev": "node server.js",
    "test": "npm run test:smoke",
    "test:smoke": "node scripts/smoke-test.js",
    "test:syntax": "node --check server.js && node --check routes/sitemap.js && node --check routes/seo-pages.js && node --check routes/seo-growth.js && node --check scripts/smoke-test.js",
    "guides:build": "python3 guides-src/build_guides.py",
    "guides:validate": "python3 guides-src/validate_guides.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "resend": "^4.0.0",
    "ws": "^8.18.0"
  },
  "engines": { "node": ">=22" }
}
