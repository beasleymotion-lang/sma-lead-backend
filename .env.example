# Copy this file to .env and fill in real values. Never commit .env itself.

# Resend (https://resend.com) — used to send all outbound emails.
# Requires a verified sending domain in production (test mode works with resend.dev addresses).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address for guide-delivery and nurture emails. Must be on a domain
# verified in your Resend account once you leave test mode.
FROM_EMAIL="Blaze Beasley <blaze@yourdomain.com>"

# Where the internal "New Website Lead" notification is sent.
NOTIFY_EMAIL=blaze@yourdomain.com

# Public URL of the deployed site (used to build guide download links and CTA buttons in emails).
SITE_URL=https://www.sanmiguelrealty.example

# CORS: the origin allowed to call this API from the browser (your website's domain).
# Use * only for local development.
ALLOWED_ORIGIN=*

# Local port for `npm start`
PORT=3001

# Optional: override where the SQLite file lives (defaults to ./data/leads.db)
# DB_PATH=./data/leads.db

# Admin dashboard password (single shared password — see README "Known limitations").
# CHANGE THIS before deploying anywhere real.
ADMIN_PASSWORD=change-me-to-something-strong

# Optional: override where property photos are stored (defaults to ./public/uploads)
# UPLOAD_DIR=./public/uploads

# Optional: override where the properties/CRM SQLite files live
# PROPERTIES_DB_PATH=./data/properties.db
# CRM_DB_PATH=./data/crm.db

# Optional: override where guide PDFs are read from when attaching them to
# delivery emails (defaults to ./public/guides)
# GUIDES_DIR=./public/guides

# Shared secret for the nurture-email cron trigger (POST /api/internal/run-nurture).
# Generate any long random string (e.g. `openssl rand -hex 32`) and use the
# SAME value on both the web service and the cron job in render.yaml.
INTERNAL_CRON_KEY=change-me-to-a-random-string
